{
  "experiment": "complete_model",
  "seed": 42,
  "gpu": 0,
  "model": {
    "channels": [64, 128, 256, 384],
    "depths": [2, 2, 3, 3],
    "head_channels": 128,
    "dropout": 0.3,
    "num_classes": 10
  },
  "data": {
    "root": "dataset",
    "split_seed": 42,
    "val_size": 5000,
    "mean": [0.5, 0.5, 0.5],
    "std": [0.5, 0.5, 0.5],
    "crop_padding": 4,
    "horizontal_flip_probability": 0.5,
    "randaugment": {
      "num_ops": 2,
      "magnitude": 9,
      "interpolation": "bilinear",
      "fill": 128
    },
    "download": true,
    "download_urls": [
      "https://cave.cs.toronto.edu/kriz/cifar-10-python.tar.gz",
      "https://www.cs.toronto.edu/~kriz/cifar-10-python.tar.gz"
    ]
  },
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "optimizer": "Adam",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "num_workers": 4,
    "scheduler": {
      "name": "cosine",
      "T_max": 99,
      "eta_min": 0.00001
    }
  },
  "safety": {
    "activation_memory_multiplier": 6.0,
    "workspace_gib": 1.0,
    "context_gib": 0.5,
    "reserve_fraction": 0.2,
    "min_reserve_gib": 1.0
  },
  "output": {
    "results_root": "results/complete_model",
    "figures_root": "figures/complete_model",
    "evaluate_test": true,
    "compute_cams": true,
    "plot": true,
    "error_examples_per_group": 4,
    "cam_classes": 2,
    "calibration_bins": 10,
    "top_confusions": 5,
    "figure_dpi": 180
  }
}
